generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "sqlite" / "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  ORDER_MANAGER
  MARKETING_MANAGER
  DELIVERY_PARTNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PACKED
  READY_FOR_PICKUP
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FLAT
  FREE_DELIVERY
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  cartItems     CartItem[]
  notifications Notification[]
  auditLogs     AuditLog[]
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  deliveryPartner DeliveryPartner?

  @@map("users")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   @default("Home")
  receiverName  String?
  receiverPhone String?
  houseFlatNo   String
  streetArea    String
  landmark      String?
  city          String
  state         String
  pincode       String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  orders        Order[]

  @@map("addresses")
}

model CartItem {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, variantId])
  @@map("cart_items")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model Order {
  id                  Int              @id @default(autoincrement())
  orderNumber         String           @unique
  userId              Int
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId             Int?
  store               Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  addressId           Int?
  address             Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryAddressJson String
  status              OrderStatus      @default(PENDING)
  subtotal            Float
  discountAmount      Float            @default(0.0)
  deliveryFee         Float            @default(0.0)
  taxAmount           Float            @default(0.0)
  tipAmount           Float            @default(0.0)
  totalAmount         Float
  paymentMethod       String
  paymentStatus       PaymentStatus    @default(PENDING)
  couponCode          String?
  deliveryPartnerId   Int?
  deliveryPartner     DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  deliveryEtaMins     Int?             @default(12)
  deliveryNotes       String?
  cancellationReason  String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  orderItems          OrderItem[]
  payments            Payment[]
  refunds             Refund[]

  @@map("orders")
}

model OrderItem {
  id           Int            @id @default(autoincrement())
  orderId      Int
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId    Int
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName  String
  variantTitle String
  unitPrice    Float
  mrp          Float
  quantity     Int
  totalPrice   Float
  imageUrl     String?

  @@map("order_items")
}

model Category {
  id            Int        @id @default(autoincrement())
  name          String
  slug          String     @unique
  description   String?
  imageUrl      String?
  iconUrl       String?
  bannerUrl     String?
  backgroundUrl String?
  parentId      Int?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("SubCategories")
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  isFeatured    Boolean    @default(false)
  createdAt     DateTime   @default(now())

  products      Product[]

  @@map("categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("brands")
}

model Product {
  id                  Int              @id @default(autoincrement())
  name                String
  shortName           String?
  slug                String           @unique
  description         String?
  categoryId          Int
  category            Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId             Int?
  brand               Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit                String           @default("piece")
  weightOrVol         String?
  sku                 String?          @unique
  barcode             String?
  hsnCode             String?
  gstRate             Float            @default(0.05)
  manufacturer        String?
  countryOfOrigin     String?          @default("India")
  shelfLifeDays       Int?             @default(30)
  storageInstructions String?
  ingredients         String?
  nutritionalInfo     String?
  highlights          String?
  specifications      String?
  returnPolicy        String?          @default("7 days replacement")
  rating              Float            @default(4.8)
  reviewsCount        Int              @default(0)
  isFeatured          Boolean          @default(false)
  isTrending          Boolean          @default(false)
  isSponsored         Boolean          @default(false)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  variants            ProductVariant[]
  images              ProductImage[]
  reviews             Review[]
  wishlists           Wishlist[]
  orderItems          OrderItem[]

  @@map("products")
}

model ProductVariant {
  id                 Int               @id @default(autoincrement())
  productId          Int
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  title              String
  sku                String?           @unique
  barcode            String?
  unit               String
  weightOrVol        String?
  mrp                Float
  sellingPrice       Float
  costPrice          Float             @default(0.0)
  discountPercentage Float             @default(0.0)
  stock              Int               @default(0)
  reservedStock      Int               @default(0)
  minStockLevel      Int               @default(5)
  maxStockLevel      Int               @default(500)
  imageUrl           String?
  isDefault          Boolean           @default(false)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  cartItems          CartItem[]
  inventory          Inventory[]
  batches            InventoryBatch[]
  orderItems         OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String?
  imageType String?  @default("gallery")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Store {
  id              Int              @id @default(autoincrement())
  name            String
  code            String           @unique
  type            String           @default("DARK_STORE")
  address         String
  city            String
  state           String
  pincode         String
  latitude        Float
  longitude       Float
  serviceRadiusKm Float            @default(8.0)
  contactPhone    String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  inventory       Inventory[]
  batches         InventoryBatch[]
  deliveryZones   DeliveryZone[]
  orders          Order[]

  @@map("stores")
}

model Inventory {
  id            Int            @id @default(autoincrement())
  storeId       Int
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantId     Int
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currentStock  Int            @default(0)
  reservedStock Int            @default(0)
  rackLocation  String?
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([storeId, variantId])
  @@map("inventory")
}

model InventoryBatch {
  id                Int            @id @default(autoincrement())
  storeId           Int
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantId         Int
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchNumber       String
  mfgDate           DateTime
  expiryDate        DateTime
  initialQuantity   Int
  availableQuantity Int
  costPerUnit       Float          @default(0.0)
  isExpired         Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@map("inventory_batches")
}

model DeliveryPartner {
  id              Int      @id @default(autoincrement())
  userId          Int?     @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  phone           String   @unique
  vehicleType     String?  @default("E-Bike")
  vehicleNumber   String?
  status          String   @default("ONLINE")
  currentLat      Float?
  currentLng      Float?
  rating          Float?   @default(4.9)
  totalDeliveries Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  orders          Order[]

  @@map("delivery_partners")
}

model DeliveryZone {
  id              Int     @id @default(autoincrement())
  storeId         Int
  store           Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pincode         String
  deliveryFee     Float   @default(29.0)
  minOrderAmount  Float   @default(99.0)
  estDeliveryMins Int     @default(12)
  isActive        Boolean @default(true)

  @@map("delivery_zones")
}

model Coupon {
  id                Int          @id @default(autoincrement())
  code              String       @unique
  title             String
  description       String?
  discountType      DiscountType
  discountValue     Float
  minOrderAmount    Float        @default(0.0)
  maxDiscountAmount Float?
  startDate         DateTime?
  endDate           DateTime?
  usageLimit        Int?         @default(1000)
  perUserLimit      Int?         @default(1)
  usageCount        Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  @@map("coupons")
}

model Offer {
  id          Int       @id @default(autoincrement())
  title       String
  subtitle    String?
  discountTag String?
  bannerUrl   String
  linkType    String?   @default("CATEGORY")
  linkTarget  String?
  bgGradient  String?
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("offers")
}

model Payment {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway            String
  transactionId      String?
  amount             Float
  currency           String   @default("INR")
  status             String
  method             String?
  paymentDetailsJson String?
  createdAt          DateTime @default(now())

  refunds            Refund[]

  @@map("payments")
}

model Refund {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId   Int?
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount      Float
  reason      String?
  status      String    @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("refunds")
}

model Advertisement {
  id               Int       @id @default(autoincrement())
  name             String
  advertiser       String?
  adType           String    @default("BANNER")
  placement        String    @default("HOMEPAGE_HERO")
  desktopImageUrl  String
  mobileImageUrl   String?
  videoUrl         String?
  destinationUrl   String?
  targetCategoryId Int?
  startDate        DateTime?
  endDate          DateTime?
  budget           Float?    @default(0.0)
  priority         Int       @default(1)
  isActive         Boolean   @default(true)
  impressions      Int       @default(0)
  clicks           Int       @default(0)
  conversions      Int       @default(0)
  revenue          Float     @default(0.0)
  createdAt        DateTime  @default(now())

  @@map("advertisements")
}

model Theme {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  isActive   Boolean  @default(false)
  configJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("themes")
}

model CMSSection {
  id              Int      @id @default(autoincrement())
  sectionKey      String   @unique
  title           String
  subtitle        String?
  sectionType     String
  contentJson     String
  backgroundType  String?  @default("CELESTIAL")
  backgroundValue String?
  bgOpacity       Float?   @default(1.0)
  bgBlur          Int?     @default(0)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cms_sections")
}

model MediaLibrary {
  id         Int      @id @default(autoincrement())
  filename   String
  filePath   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  dimensions String?
  altText    String?
  createdAt  DateTime @default(now())

  @@map("media_library")
}

model Review {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating        Int
  title         String?
  comment       String
  status        String   @default("APPROVED")
  adminResponse String?
  createdAt     DateTime @default(now())

  @@map("reviews")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model Setting {
  key         String   @id
  value       String
  category    String   @default("GENERAL")
  isSecret    Boolean  @default(false)
  description String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("settings")
}

model SearchAnalytic {
  id           Int      @id @default(autoincrement())
  query        String
  resultsCount Int      @default(0)
  userId       Int?
  createdAt    DateTime @default(now())

  @@map("search_analytics")
}