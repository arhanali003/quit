# ---------- CORE ----------
# Dev uses SQLite. For production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/quickit"
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- AUTH ----------
# Secret used to sign session JWTs. REQUIRED in production. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
# OTP delivery: "console" logs OTP to server logs (dev). Set provider keys below for real SMS.
OTP_PROVIDER="console"

# ---------- PAYMENTS (never expose secrets to the frontend) ----------
# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------- NOTIFICATION PROVIDERS (optional - console fallback in dev) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# ---------- STORAGE ----------
# "local" writes to /public/uploads. Swap for S3-compatible storage in production.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
